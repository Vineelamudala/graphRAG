# OPTIONAL: copy this file to ".env" (same folder) and fill in your values.
# The app then uses them whenever a sidebar field is left empty, so you don't
# have to type them each time. The values are never shown in the app.
# Never commit your real .env file. It is listed in .gitignore.

# Neo4j (for Aura: Console > your instance > Connect)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Groq (create a key at https://console.groq.com/keys)
GROQ_API_KEY=

# OPTIONAL: defaults for the "LiteLLM" choice in the app's sidebar (see README, "Using a LiteLLM proxy").
# You can also just type these in the sidebar. Remove the "#" to use them.
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=sk-...
# LLM_MODEL=gpt-oss-20b
